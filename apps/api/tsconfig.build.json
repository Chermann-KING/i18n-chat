{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@i18n-chat/domain": ["../../packages/domain/src"],
      "@i18n-chat/dto": ["../../packages/dto/src"],
      "@i18n-chat/database": ["../../packages/database/src"]
    },
    "incremental": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*",
    "../../packages/domain/src/**/*",
    "../../packages/dto/src/**/*",
    "../../packages/database/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
