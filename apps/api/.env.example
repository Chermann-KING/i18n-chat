# ─── Application ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://i18n_user:i18n_pass@localhost:5432/i18n_chat

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Translation provider ─────────────────────────────────────────────────────
# Active provider: ModernMtService (swap to LibreTranslateService in TranslationModule)
MODERNMT_API_KEY=CHANGE_ME

# ─── LibreTranslate (alternative — self-hosted, GDPR-first) ──────────────────
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# ─── Email (Brevo SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=noreply@institution.be

# ─── SMS Provider ─────────────────────────────────────────────────────────────
SMS_PROVIDER_API_KEY=CHANGE_ME
SMS_FROM=+32XXXXXXXXX

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
WA_PHONE_NUMBER_ID=CHANGE_ME
WA_ACCESS_TOKEN=CHANGE_ME
WA_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
WA_BUSINESS_ACCOUNT_ID=CHANGE_ME

# ─── Encryption (AES-256-GCM — contact data at rest) ─────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_hex_characters

# ─── GDPR ─────────────────────────────────────────────────────────────────────
ANONYMOUS_TARGET_TTL_DAYS=30
