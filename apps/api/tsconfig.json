{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@i18n-chat/domain": ["../../packages/domain/src"],
      "@i18n-chat/dto": ["../../packages/dto/src"],
      "@i18n-chat/database": ["../../packages/database/src"]
    }
  },
  "references": [
    { "path": "../../packages/domain" },
    { "path": "../../packages/dto" },
    { "path": "../../packages/database" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
