// =============================================================================
// i18n-chat — Prisma Schema
// =============================================================================
// Rules:
//  - All UUIDs generated by the database (@default(dbgenerated("gen_random_uuid()")))
//  - Contacts (email, phone) are encrypted at application layer before storage
//  - audit_logs is append-only: no UPDATE or DELETE permitted (enforced in AuditService)
//  - anonymous_targets.purgeAt drives GDPR TTL (30 days)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Reference Data ───────────────────────────────────────────────────────────

/// A language supported by the platform (both staff UI and recipient translations).
model Language {
  /// ISO 639-1 code, e.g. 'fr', 'nl', 'en', 'ar'.
  code     String  @id @db.VarChar(10)
  label    String
  isActive Boolean @default(true)

  users                User[]
  recipients           Recipient[]
  anonymousTargets     AnonymousTarget[]
  templateTranslations TemplateTranslation[]

  @@map("languages")
}

// ─── Identity & Access ────────────────────────────────────────────────────────

/// A staff member who can log in and use the platform.
model User {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String   @unique
  /// Hashed with argon2 — never store plaintext.
  passwordHash          String
  firstName             String?
  lastName              String?
  role                  UserRole @default(SENDER)
  preferredLanguageCode String   @default("fr") @db.VarChar(10)
  /// When true, the user receives an email when one of their dispatches fails.
  notifyOnFailure       Boolean  @default(false)
  /// When true, the user is prompted to change their password on first login.
  /// Set to true by UserService.create(); cleared when the password is changed or the prompt is dismissed.
  mustChangePassword    Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  preferredLanguage Language      @relation(fields: [preferredLanguageCode], references: [code])
  refreshTokens     RefreshToken[]
  dispatches        Dispatch[]
  auditLogs         AuditLog[]
  templates         Template[]

  @@map("users")
}

/// JWT refresh token — rotated on every use (7-day TTL).
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  /// bcrypt/argon2 hash of the raw token — never store the raw value.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SENDER
  VIEWER
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum RecipientMode {
  REGISTERED
  ANONYMOUS
}

enum DispatchStatus {
  DRAFT
  QUEUED
  IN_PROGRESS
  DONE
  CANCELLED
  FAILED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum WaTemplateStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum WaTemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum VariableType {
  TEXT
  NUMBER
  DATE
  TIME
}

enum VariableSource {
  MANUAL
  RECIPIENT_FIELD
}

enum RecipientField {
  firstName
  lastName
}

// ─── Recipients ───────────────────────────────────────────────────────────────

/// A registered recipient profile with a known preferred language.
model Recipient {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName             String
  lastName              String
  preferredLanguageCode String   @db.VarChar(10)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  preferredLanguage Language          @relation(fields: [preferredLanguageCode], references: [code])
  channels          RecipientChannel[]
  messages          Message[]
  variableSets      DispatchVariableSet[]

  @@index([preferredLanguageCode])
  @@map("recipients")
}

/// A contact address (email or phone) for a registered recipient on a given channel.
/// The `contact` field is encrypted at the application layer before persistence (pgcrypto).
model RecipientChannel {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String         @db.Uuid
  channel     MessageChannel
  /// Encrypted at rest: email address or E.164 phone number.
  contact     String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, channel])
  @@index([channel])
  @@map("recipient_channels")
}

// ─── Templates ────────────────────────────────────────────────────────────────

/// A reusable message template that can be translated into multiple languages.
model Template {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable display name, e.g. 'Rappel de rendez-vous'.
  name                 String
  /// Machine-readable identifier, e.g. 'appointment_reminder'. Must be unique.
  slug                 String   @unique
  category             String   @default("general")
  /// ISO 639-1 code of the language used when no translation exists for a recipient's language.
  fallbackLanguageCode String   @default("en")
  createdById          String   @db.Uuid
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  createdBy    User                  @relation(fields: [createdById], references: [id])
  variables    TemplateVariable[]
  translations TemplateTranslation[]
  dispatches   Dispatch[]

  @@map("templates")
}

/// A variable placeholder declared in a template, e.g. `{{prenom}}`, `{{date}}`.
model TemplateVariable {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId   String  @db.Uuid
  /// Handlebars key, e.g. 'prenom', 'date', 'lieu'.
  key          String
  /// Human-readable label shown to the sender in the UI.
  label        String
  /// Determines which input widget is shown in the dispatch wizard.
  type          VariableType   @default(TEXT)
  /// Whether the value is typed by staff (MANUAL) or auto-injected from the recipient profile (RECIPIENT_FIELD).
  source        VariableSource @default(MANUAL)
  /// When source is RECIPIENT_FIELD, the recipient profile field to map.
  recipientField RecipientField?
  isRequired    Boolean        @default(true)
  defaultValue  String?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@map("template_variables")
}

/// One language version of a template's body (and optional subject for email).
model TemplateTranslation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId   String  @db.Uuid
  languageCode String  @db.VarChar(10)
  /// Localized name of the template in this language. Falls back to the template-level name when absent.
  name         String?
  /// Used as the email subject line. Ignored for SMS and WhatsApp.
  subject      String?
  /// Handlebars template string, e.g. "Bonjour {{prenom}}, votre RDV est le {{date}}."
  body         String
  /// Per-language labels for each variable key, e.g. {"date": "Datum van de afspraak"}.
  /// Falls back to TemplateVariable.label when absent.
  variableLabels Json?

  // ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────
  /// Approved HSM template name in Meta Business Manager.
  waTemplateName     String?
  waTemplateStatus   WaTemplateStatus    @default(NOT_SUBMITTED)
  waTemplateCategory WaTemplateCategory?
  /// Template ID returned by Meta after approval.
  waTemplateMetaId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageCode], references: [code])

  @@unique([templateId, languageCode])
  @@map("template_translations")
}

// ─── Dispatches ───────────────────────────────────────────────────────────────

/// A message sending operation targeting one or more recipients.
model Dispatch {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById   String         @db.Uuid
  recipientMode RecipientMode
  /// Null when recipientMode = REGISTERED (template-based).
  templateId    String?        @db.Uuid
  /// Non-null when the sender wrote a free-text message (translated by LibreTranslate).
  freeTextOriginal String?
  status        DispatchStatus @default(DRAFT)
  scheduledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdBy        User                  @relation(fields: [createdById], references: [id])
  template         Template?             @relation(fields: [templateId], references: [id])
  anonymousTargets AnonymousTarget[]
  variableSets     DispatchVariableSet[]
  messages         Message[]

  @@index([createdById])
  @@index([status])
  @@map("dispatches")
}

/// An ad-hoc recipient for a single dispatch (anonymous mode).
/// GDPR: all rows with purgeAt <= NOW() must be deleted by the scheduled purge job.
model AnonymousTarget {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispatchId   String         @db.Uuid
  channel      MessageChannel
  /// Encrypted at rest: email address or E.164 phone number.
  contact      String
  languageCode String         @db.VarChar(10)
  /// Handlebars variable values, e.g. {"prenom": "Amina", "date": "30/03/2026"}.
  variables    Json           @default("{}")
  /// Scheduled deletion date — set to createdAt + ANONYMOUS_TARGET_TTL_DAYS.
  purgeAt      DateTime
  createdAt    DateTime       @default(now())

  dispatch     Dispatch              @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  language     Language              @relation(fields: [languageCode], references: [code])
  messages     Message[]
  variableSets DispatchVariableSet[]

  @@index([purgeAt])
  @@map("anonymous_targets")
}

/// Variable values provided by the sender when creating a dispatch.
/// When recipientId and anonymousTargetId are both null, the values apply to ALL recipients.
model DispatchVariableSet {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispatchId        String  @db.Uuid
  /// Null = global values for all recipients in this dispatch.
  recipientId       String? @db.Uuid
  anonymousTargetId String? @db.Uuid
  /// Map of variable key → value, e.g. {"prenom": "Chermann", "date": "30/03/2026"}.
  variables         Json

  dispatch        Dispatch         @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  recipient       Recipient?       @relation(fields: [recipientId], references: [id])
  anonymousTarget AnonymousTarget? @relation(fields: [anonymousTargetId], references: [id])

  @@map("dispatch_variable_sets")
}

// ─── Messages ─────────────────────────────────────────────────────────────────

/// One outbound message destined for a single recipient on a single channel.
/// Exactly one of recipientId or anonymousTargetId must be set.
model Message {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispatchId        String        @db.Uuid
  recipientId       String?       @db.Uuid
  anonymousTargetId String?       @db.Uuid
  channel           MessageChannel
  languageCode      String        @db.VarChar(10)
  /// Final rendered and translated body ready for delivery.
  translatedBody    String
  status            MessageStatus @default(PENDING)
  /// Message ID returned by the channel provider (Brevo, Twilio, Meta…).
  providerMessageId String?
  errorDetails      Json?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  dispatch        Dispatch         @relation(fields: [dispatchId], references: [id])
  recipient       Recipient?       @relation(fields: [recipientId], references: [id])
  anonymousTarget AnonymousTarget? @relation(fields: [anonymousTargetId], references: [id])

  @@index([dispatchId, status])
  @@index([status])
  @@map("messages")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

/// Immutable audit trail — append-only. No UPDATE or DELETE is ever performed on this table.
/// All mutations throughout the application must produce an entry here.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @db.Uuid
  /// Dot-namespaced action, e.g. 'dispatch.created', 'template.translation.updated'.
  action     String
  entityType String
  entityId   String   @db.Uuid
  /// Additional context attached to the event (user agent, IP, changed fields, etc.).
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
